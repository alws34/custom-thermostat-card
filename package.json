{
  "name": "custom-thermostat-card",
  "version": "0.2.2",
  "description": "Adaptive Home Assistant Lovelace thermostat card with a horseshoe dial, compact tiles, inline expansion and an accessible overlay. Climate and water_heater, theme-driven, card-mod friendly.",
  "type": "module",
  "main": "dist/custom-thermostat-card.js",
  "module": "dist/custom-thermostat-card.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/alws34/custom-thermostat-card.git"
  },
  "bugs": {
    "url": "https://github.com/alws34/custom-thermostat-card/issues"
  },
  "homepage": "https://github.com/alws34/custom-thermostat-card#readme",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"*.md\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/build.mjs && node scripts/smoke.mjs",
    "preview": "node scripts/build.mjs && node preview/serve.mjs"
  },
  "keywords": [
    "home-assistant",
    "lovelace",
    "thermostat",
    "climate",
    "water-heater",
    "hacs",
    "custom-card",
    "lit"
  ],
  "author": "alws34",
  "license": "MIT",
  "dependencies": {
    "lit": "^3.2.1"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "custom-card-helpers": "^1.9.0",
    "esbuild": "^0.24.0",
    "eslint": "^8.57.1",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
